# Host directory shared by the backend and packaged DroneLume simulator.
# Windows local packaged build example:
# DRONELUME_CONFIG_DIR=G:\UE_project\DroneWorld 5.5\Packaged\Windows\DRV\Config
DRONELUME_CONFIG_DIR=./config/dronelume
# Optional external selector catalog. The checked-in backend catalog is used by default.
# DRONELUME_CATALOG_PATH=./config/dronelume_catalog.json

# Native Ollama used by the backend-only guided scenario endpoint.
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=90

# Required when UAVLab-SLU/DRV-Unreal is private. Authorize organization SSO.
# GITHUB_TOKEN=github_pat_xxx

# Optional AirSim settings directory shared with the Unreal container.
AIRSIM_SETTINGS_DIR=./config/airsim

# Pixel Streaming browser endpoint. The helper script detects the desktop IPv4
# address for TURN. Set it explicitly if automatic detection chooses the wrong NIC.
PIXELSTREAM_HTTP_PORT=8888
# PIXELSTREAM_PUBLIC_IP=192.168.1.10
# PIXELSTREAM_TURN_USER=drv
# PIXELSTREAM_TURN_PASSWORD=change-this-for-non-local-use

# Match the major version reported by the Windows NVIDIA driver.
NVIDIA_GL_DRIVER_MAJOR=610
