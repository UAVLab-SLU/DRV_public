# Ignore .env files
.env

# Ignore Visual Studio files
.vs/

# Ignore virtual environments
backend/venv/

# Ignore Node.js dependencies
node_modules/

# Ignore Python bytecode files and __pycache__ directories globally
*.pyc
__pycache__/

# Ignore backend-specific files
backend/*.csv
backend/*.html
backend/*.png
backend/*.jpg

# Frontend ignores
# dependencies
frontend/node_modules
frontend/.pnp
frontend/.pnp.js

# testing
frontend/coverage

# production
frontend/build

# misc
frontend/.DS_Store
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Ignore frontend package-lock.json
frontend/package-lock.json

# Ignore Windows system file
desktop.ini

# Ignore Google Cloud service account key
key.json

# Keep only the empty DroneLume mount point. Runtime configuration stays local.
config/*
!config/dronelume/
config/dronelume/*
!config/dronelume/.gitkeep

# Downloaded packaged Unreal releases are local Docker build inputs.
sim/release/
sim/release-staging-*/
sim/*.zip
sim/windows-release/
sim/windows-control.pid

# MaOS system files
.DS_Store

# VS Code workspace files
*.code-workspace
