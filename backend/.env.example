# DroneLume writes the validated file as InitDSL.json in this directory.
# Local packaged Windows example:
# DRONELUME_CONFIG_DIR=G:\UE_project\DroneWorld 5.5\Packaged\Windows\DRV\Config
# Docker Compose sets the container path automatically and mounts the host path
# from the root-level DRONELUME_CONFIG_DIR variable.
DRONELUME_CONFIG_DIR=/app/dronelume-config
# Optional external selector catalog path.
# DRONELUME_CATALOG_PATH=/app/dronelume-config/dronelume_catalog.json

# Guided scenario model. Use localhost when the backend runs natively and
# http://host.docker.internal:11434 when the backend runs in Docker.
SCENARIO_MODEL_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_KEEP_ALIVE=5m
